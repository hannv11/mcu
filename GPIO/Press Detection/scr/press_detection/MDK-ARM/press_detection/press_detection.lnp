--cpu Cortex-M3
"press_detection\startup_stm32f103xb.o"
"press_detection\main.o"
"press_detection\stm32f1xx_it.o"
"press_detection\stm32f1xx_hal_msp.o"
"press_detection\stm32f1xx_hal_gpio_ex.o"
"press_detection\stm32f1xx_hal_uart.o"
"press_detection\stm32f1xx_hal.o"
"press_detection\stm32f1xx_hal_rcc.o"
"press_detection\stm32f1xx_hal_rcc_ex.o"
"press_detection\stm32f1xx_hal_gpio.o"
"press_detection\stm32f1xx_hal_dma.o"
"press_detection\stm32f1xx_hal_cortex.o"
"press_detection\stm32f1xx_hal_pwr.o"
"press_detection\stm32f1xx_hal_flash.o"
"press_detection\stm32f1xx_hal_flash_ex.o"
"press_detection\stm32f1xx_hal_exti.o"
"press_detection\system_stm32f1xx.o"
--strict --scatter "press_detection\press_detection.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "press_detection.map" -o press_detection\press_detection.axf